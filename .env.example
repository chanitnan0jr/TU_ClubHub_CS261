# ==============================================================================
# TU-ClubHub Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Modify values as needed for your local environment.
# 3. WARNING: Do NOT commit actual secrets or production keys to version control.
# ==============================================================================

# Application HTTP Port
PORT=8080

# Spring Active Profile: dev / test / prod
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=tu_clubhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_clubhub_dev_secret

# Password alias for Spring Boot datasource in application-dev.yml
DB_PASSWORD=tu_clubhub_dev_secret

# ------------------------------------------------------------------------------
# TU Authentication API
# ------------------------------------------------------------------------------
# Mode: "mock" (default for local development & testing) or "real" (production/staging)
TU_AUTH_MODE=mock

# TU OAuth / API Endpoint URL (Required when TU_AUTH_MODE=real)
TU_AUTH_ENDPOINT_URL=

# TU Application Key (Required when TU_AUTH_MODE=real)
TU_AUTH_APPLICATION_KEY=
