// TU-ClubHub — proposed domain/database design for Release 1 + Release 2.
// Revision: 17 tables; term-based committee assignments; updated club and recruitment data.
// Nullable references use >?; mandatory references use >.
// Muted gray lines identify account/actor references; no foreign keys are hidden.
// TableGroup/headercolor control grouping and colors, not canvas coordinates.
// Older companion layouts have 16 tables; arrange the new assignment table near memberships.
// No invented x/y metadata is used. Nullable references retain the supplied >? dialect.
// Paste the entire file into dbdiagram.io. Database: PostgreSQL.
// Java: snake_case columns -> camelCase fields; bigint -> Long;
// timestamptz -> Instant; status varchar -> Java enum with EnumType.STRING.
// This is a design proposal, not an inspection of an existing implementation.
// Authorization policy adopted 2026-10-19: ../security/permission-matrix.md.
// Policy notes below describe requirements; they do not add SQL constraints or deployed guards.
// Task74 documentation update 2026-10-27: Sprint 2 additions are Draft / Pending Review.
// Product decisions below record the user's instruction on 2026-10-27 and remain
// Pending Team Review; they are not a runtime change or completed PO/Reviewer sign-off.
// Canonical flow/rule index/decision log: ../architecture/system-architecture.md.
// Review/handoff artefact: ../architecture/task74-sprint2-analysis.md.
// Assumptions: one category per club; text-only selection questions;
// one application per student per round; one membership per student per club;
// accepted applicants become members only after confirming their place.
// A published recruitment round is also its recruitment announcement.
// No file uploads: store HTTPS links only; no automatic server-side fetching.
// Session JDBC tables are technical infrastructure and omitted from this ERD.

Project TU_ClubHub {
  database_type: 'PostgreSQL'
  Note: 'TU-ClubHub: club discovery, recruitment, review, confirmation, membership and in-app notifications.'
}

Table users [headercolor: #2563EB] {
  id                       bigint [pk, increment]
  tu_username              varchar(100) [not null, unique, note: 'Stable TU login identity; never store TU passwords']
  display_name             varchar(200) [not null]
  email                    varchar(254)
  system_role              varchar(20) [not null, default: 'USER']
  account_status           varchar(20) [not null, default: 'ACTIVE']
  last_login_at            timestamptz
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0, note: 'Java @Version; incremented by ORM']
  checks {
    `system_role IN ('USER', 'ADMIN')`
    `account_status IN ('ACTIVE', 'SUSPENDED')`
  }
  Note: 'Java: User. Club committee privileges come from effective ClubCommitteeAssignment records, not system_role.'
}

Table student_profiles [headercolor: #2563EB] {
  user_id                  bigint [pk]
  student_code             varchar(20) [not null, unique]
  faculty_name             varchar(200)
  department_name          varchar(200)
  program_name             varchar(200) [note: 'Curriculum/program name; distinct from department']
  study_year               smallint
  student_status           varchar(20) [not null, default: 'UNKNOWN']
  synced_at                timestamptz [not null, default: `now()`]
  checks {
    `study_year IS NULL OR study_year > 0`
    `student_status IN ('ACTIVE', 'INACTIVE', 'GRADUATED', 'UNKNOWN')`
  }
  Note: 'Java: StudentProfile; @MapsId with User. Status is our normalized value, not a claim about TU API field names. Verified ACTIVE is required to apply, confirm membership, or exercise committee privileges. Login alone does not establish eligibility. An ACTIVE account may still read its own existing records when student status is INACTIVE, GRADUATED or UNKNOWN.'
}

Table club_categories [headercolor: #0F766E] {
  id                       bigint [pk, increment]
  name                     varchar(100) [not null, unique]
  description              text
  Note: 'Java: ClubCategory. One primary category per club in this proposal.'
}

Table clubs [headercolor: #0F766E] {
  id                       bigint [pk, increment]
  category_id              bigint [not null]
  name                     varchar(200) [not null, unique]
  description              text [not null]
  objectives               text
  contact_url              varchar(2048) [note: 'Other website/contact URL']
  facebook_url             varchar(2048)
  instagram_url            varchar(2048)
  contact_email            varchar(254) [note: 'Validate email format in Java; not an HTTPS URL']
  affiliation_level        varchar(30) [note: 'University/faculty/other approved level; vocabulary defined by project']
  affiliation_name         varchar(200)
  image_url                varchar(2048) [note: 'Optional external HTTPS image; otherwise use bundled default image']
  banner_url               varchar(2048) [note: 'Optional external HTTPS banner; no file upload']
  status                   varchar(20) [not null, default: 'ACTIVE']
  created_by               bigint [not null]
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  indexes {
    (category_id, status)
  }
  checks {
    `status IN ('ACTIVE', 'INACTIVE')`
    `contact_url IS NULL OR contact_url ~* '^https://[^[:space:]]+$'`
    `image_url IS NULL OR image_url ~* '^https://[^[:space:]]+$'`
    `banner_url IS NULL OR banner_url ~* '^https://[^[:space:]]+$'`
    `facebook_url IS NULL OR facebook_url ~* '^https://[^[:space:]]+$'`
    `instagram_url IS NULL OR instagram_url ~* '^https://[^[:space:]]+$'`
  }
  Note: 'Java: Club. HTTPS checks are basic guards; validate URI scheme and host in Java too.'
}

Table tags [headercolor: #0F766E] {
  id                       bigint [pk, increment]
  name                     varchar(80) [not null, unique]
  Note: 'Java: Tag. Normalize whitespace/case before creating tags.'
}

Table club_tags [headercolor: #0F766E] {
  club_id                  bigint [not null]
  tag_id                   bigint [not null]
  indexes {
    (club_id, tag_id) [pk]
    tag_id
  }
  Note: 'Join table. Java may use Club.tags: Set<Tag>; a separate entity is unnecessary until this association needs additional attributes.'
}

Table recruitment_rounds [headercolor: #B45309] {
  id                       bigint [pk, increment]
  club_id                  bigint [not null]
  title                    varchar(200) [not null]
  academic_year            smallint [not null, note: 'Buddhist Era academic year, e.g. 2569; not derived from the current calendar year']
  semester                 smallint [not null, note: 'Positive semester code; approved codes and summer-term meaning are project policy']
  description              text [not null]
  eligibility_text         text [note: 'Human-readable conditions; not executable validation rules']
  opens_at                 timestamptz [not null]
  closes_at                timestamptz [not null, note: 'Original scheduled closing time; do not overwrite to close early']
  closed_at                timestamptz [note: 'Actual manual early-close time; NULL when no early close was performed']
  results_scheduled_at     timestamptz [note: 'Announced result schedule; distinct from actual publication time']
  confirmation_deadline    timestamptz [not null]
  publication_status       varchar(20) [not null, default: 'DRAFT']
  published_at             timestamptz
  results_published_at     timestamptz [note: 'Release final results to applicants only after this is set']
  created_by               bigint [not null]
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  indexes {
    (id, club_id) [unique]
    (club_id, publication_status, opens_at)
    (academic_year, semester, club_id)
  }
  checks {
    `academic_year > 0`
    `semester > 0`
    `opens_at < closes_at`
    `closed_at IS NULL OR (closed_at >= opens_at AND closed_at < closes_at)`
    `closed_at IS NULL OR published_at IS NOT NULL`
    `results_scheduled_at IS NULL OR (results_scheduled_at >= opens_at AND results_scheduled_at < confirmation_deadline)`
    `confirmation_deadline > closes_at`
    `publication_status IN ('DRAFT', 'PUBLISHED', 'CANCELLED')`
    `publication_status <> 'PUBLISHED' OR published_at IS NOT NULL`
    `results_published_at IS NULL OR (published_at IS NOT NULL AND results_published_at >= published_at AND results_published_at >= opens_at AND results_published_at < confirmation_deadline)`
  }
  Note: 'Java: RecruitmentRound. Open for applications only when PUBLISHED and opens_at <= now < closes_at and closed_at IS NULL. Closing early preserves existing applications and closes_at. Actual selection-result publication requires effective closure under the Permission Matrix; results_scheduled_at does not publish results. Confirmation starts at results_published_at and ends before confirmation_deadline. Question edits are limited to drafts without applications. Additional Task74 proposals remain Pending Review; service policies are not all imposed as DB checks.'
}

Table application_questions [headercolor: #B45309] {
  id                       bigint [pk, increment]
  round_id                 bigint [not null]
  prompt                   text [not null]
  is_required              boolean [not null, default: true]
  display_order            int [not null]
  max_length               int [not null, default: 2000]
  indexes {
    (id, round_id) [unique]
    (round_id, display_order) [unique]
  }
  checks {
    `display_order > 0`
    `max_length > 0`
  }
  Note: 'Java: ApplicationQuestion. MVP supports text answers only.'
}

Table applications [headercolor: #7C3AED] {
  id                       bigint [pk, increment]
  round_id                 bigint [not null]
  club_id                  bigint [not null, note: 'Controlled redundancy for composite foreign keys']
  applicant_id             bigint [not null]
  motivation               text [not null]
  status                   varchar(30) [not null, default: 'SUBMITTED']
  submitted_at             timestamptz [not null, default: `now()`]
  decided_by               bigint
  decided_at               timestamptz
  result_message           text [note: 'Applicant-visible message after results are published; never copy private review notes here automatically']
  responded_at             timestamptz [note: 'Time of student confirmation/decline; remains NULL for automatic EXPIRED']
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  indexes {
    (round_id, applicant_id) [unique]
    (id, round_id) [unique]
    (id, applicant_id, club_id) [unique]
    (applicant_id, submitted_at)
    (club_id, status)
  }
  checks {
    `status IN ('SUBMITTED', 'UNDER_REVIEW', 'ACCEPTED', 'REJECTED', 'CONFIRMED', 'DECLINED', 'WITHDRAWN', 'EXPIRED')`
    `(decided_by IS NULL) = (decided_at IS NULL)`
    `status NOT IN ('ACCEPTED', 'REJECTED', 'CONFIRMED', 'DECLINED', 'EXPIRED') OR decided_at IS NOT NULL`
    `(status IN ('CONFIRMED', 'DECLINED')) = (responded_at IS NOT NULL)`
  }
  Note: 'Java: Application. Submit once per round; withdrawn applications are retained and do not permit a second submission in this proposal. Final decision belongs to this record (status, decided_by, decided_at); reviews are advisory opinions. UI maps SUBMITTED to Pending and both DECLINED/EXPIRED to declined, with expiry reason shown separately. Status transitions and authorization belong to transactional services.'
}

Table application_answers [headercolor: #7C3AED] {
  id                       bigint [pk, increment]
  application_id           bigint [not null]
  question_id              bigint [not null]
  round_id                 bigint [not null, note: 'Both parents must belong to this same round']
  answer_text              text [not null]
  indexes {
    (application_id, question_id) [unique]
    (question_id, round_id)
  }
  Note: 'Java: ApplicationAnswer. Service verifies all required questions and per-question length at submission.'
}

Table application_links [headercolor: #7C3AED] {
  id                       bigint [pk, increment]
  application_id           bigint [not null]
  label                    varchar(200) [not null]
  url                      varchar(2048) [not null]
  display_order            int [not null]
  created_at               timestamptz [not null, default: `now()`]
  indexes {
    (application_id, display_order) [unique]
  }
  checks {
    `display_order > 0`
    `url ~* '^https://[^[:space:]]+$'`
  }
  Note: 'Java: ApplicationLink. External document/portfolio link. Backend validates a valid HTTPS URI with a host; reviewers open the origin website themselves. Never upload or fetch files automatically.'
}

Table application_reviews [headercolor: #7C3AED] {
  id                       bigint [pk, increment]
  application_id           bigint [not null]
  reviewer_id              bigint [not null]
  recommendation           varchar(20) [not null]
  internal_comment         text
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  indexes {
    (application_id, reviewer_id) [unique]
    reviewer_id
  }
  checks {
    `recommendation IN ('ACCEPT', 'REJECT', 'DISCUSS')`
  }
  Note: 'Java: ApplicationReview. One editable opinion per reviewer per application; not the final decision. Service checks the effective committee policy, including ACTIVE account, student profile, club and membership, and an unrevoked assignment within its term. Under the policy adopted 2026-10-19, a user with an application in a round cannot access that round as committee in any application status. Internal opinions and unpublished results are hidden from applicant responses; see the permission matrix.'
}

Table application_status_history [headercolor: #7C3AED] {
  id                       bigint [pk, increment]
  application_id           bigint [not null]
  from_status              varchar(30) [note: 'NULL for initial submission']
  to_status                varchar(30) [not null]
  actor_id                 bigint [note: 'NULL for system action, e.g. expiry']
  reason                   text
  changed_at               timestamptz [not null, default: `now()`]
  indexes {
    (application_id, changed_at)
  }
  checks {
    `from_status IS NULL OR from_status IN ('SUBMITTED', 'UNDER_REVIEW', 'ACCEPTED', 'REJECTED', 'CONFIRMED', 'DECLINED', 'WITHDRAWN', 'EXPIRED')`
    `to_status IN ('SUBMITTED', 'UNDER_REVIEW', 'ACCEPTED', 'REJECTED', 'CONFIRMED', 'DECLINED', 'WITHDRAWN', 'EXPIRED')`
    `from_status IS NULL OR from_status <> to_status`
  }
  Note: 'Java: ApplicationStatusHistory. Append-only via service; write in the same transaction as status change. Contains internal decisions; applicant DTO must hide unreleased results.'
}

Table club_memberships [headercolor: #15803D] {
  id                       bigint [pk, increment]
  club_id                  bigint [not null]
  user_id                  bigint [not null]
  source_application_id    bigint [unique, note: 'NULL for authorized initial/manual membership provisioning']
  status                   varchar(20) [not null, default: 'ACTIVE']
  joined_at                timestamptz [not null]
  ended_at                 timestamptz
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  indexes {
    (club_id, user_id) [unique]
    (user_id, status)
    (club_id, status)
  }
  checks {
    `status IN ('ACTIVE', 'INACTIVE', 'LEFT', 'REMOVED')`
    `(status IN ('LEFT', 'REMOVED')) = (ended_at IS NOT NULL)`
    `ended_at IS NULL OR ended_at >= joined_at`
  }
  Note: 'Java: ClubMembership. Current relationship, not a User subclass. User-recorded T74-D07 on 2026-10-27: fresh confirmation creates a membership only when no prior target-club row exists; ACTIVE/INACTIVE/LEFT/REMOVED rows block fresh confirmation unchanged. Same-application final-action retry reads its old outcome without writes; MVP has no reactivation. Preserve source and history. Membership source must match both student and club. Committee roles and terms exist only in club_committee_assignments; expiry of an assignment does not end membership. Pending Team Review; no runtime change implied.'
}

Table club_committee_assignments [headercolor: #15803D] {
  id                       bigint [pk, increment]
  membership_id            bigint [not null, note: 'Student and club are obtained through this membership; no duplicate user_id/club_id']
  position_name            varchar(100) [not null]
  permission_role          varchar(20) [not null, default: 'COMMITTEE']
  starts_at                timestamptz [not null]
  ends_at                  timestamptz [not null, note: 'Exclusive end of the assigned term']
  status                   varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE means not revoked; current privileges also depend on time and membership/account status']
  assigned_by              bigint [not null]
  revoked_by               bigint
  revoked_at               timestamptz
  revocation_reason        text
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  indexes {
    (membership_id, permission_role, starts_at) [unique]
    (membership_id, status, starts_at, ends_at)
  }
  checks {
    `permission_role IN ('COMMITTEE', 'PRESIDENT')`
    `status IN ('ACTIVE', 'REVOKED')`
    `starts_at < ends_at`
    `(status = 'REVOKED') = (revoked_at IS NOT NULL)`
    `(revoked_at IS NULL) = (revoked_by IS NULL)`
    `revoked_at IS NULL OR revoked_at >= created_at`
  }
  Note: 'Java: ClubCommitteeAssignment stores membership_id as a scalar ID owned by the membership module. Each term is a separate retained row. Effective privileges require ACTIVE account, student profile, club and membership; membership joined_at <= now and ended_at IS NULL; assignment ACTIVE, revoked_at IS NULL and starts_at <= now < ends_at. Backend UTC time is authoritative; no expiration job is required. PRESIDENT is required for selection-result publication and round cancellation. A committee member cannot manage any round in which they have an application, in any status. Admin provisions assignments but cannot appoint itself or override club authorization. Revoke instead of deleting; role/term corrections use revoke-and-create. Prevent overlapping non-revoked terms for the same membership and permission_role. See the permission matrix for action and audit requirements; these notes do not implement them.'
}

Table membership_history [headercolor: #15803D] {
  id                       bigint [pk, increment]
  membership_id            bigint [not null]
  old_status               varchar(20)
  new_status               varchar(20) [not null]
  actor_id                 bigint
  reason                   text
  changed_at               timestamptz [not null, default: `now()`]
  indexes {
    (membership_id, changed_at)
  }
  checks {
    `old_status IS NULL OR old_status IN ('ACTIVE', 'INACTIVE', 'LEFT', 'REMOVED')`
    `new_status IN ('ACTIVE', 'INACTIVE', 'LEFT', 'REMOVED')`
    `old_status IS NULL OR old_status <> new_status`
  }
  Note: 'Java: MembershipHistory. Append-only record of membership joins and status changes, retaining any earlier periods; reason includes termination reason. T74-D07 excludes new reactivation from MVP and preserves existing history/source. Committee appointments are separate term records, not membership status changes.'
}

Table notifications [headercolor: #BE185D] {
  id                       bigint [pk, increment]
  recipient_id             bigint [not null]
  application_id           bigint
  membership_id            bigint
  type                     varchar(30) [not null]
  title                    varchar(200) [not null]
  message                  text [not null]
  deduplication_key        varchar(200) [not null, unique, note: 'Stable recipient+event key to prevent duplicate notifications on retries']
  created_at               timestamptz [not null, default: `now()`]
  read_at                  timestamptz
  indexes {
    (recipient_id, read_at, created_at)
  }
  checks {
    `type IN ('APPLICATION_SUBMITTED', 'RESULT_PUBLISHED', 'APPLICATION_CONFIRMED', 'MEMBERSHIP_UPDATED')`
    `read_at IS NULL OR read_at >= created_at`
    `(type = 'MEMBERSHIP_UPDATED' AND membership_id IS NOT NULL AND application_id IS NULL) OR (type <> 'MEMBERSHIP_UPDATED' AND application_id IS NOT NULL AND membership_id IS NULL)`
  }
  Note: 'Java: Notification. In-app only. Insert with business transaction; result notices are created only when results are published. Recipient and referenced-object visibility must be checked by the service.'
}

// Identity / club discovery
Ref: users.id - student_profiles.user_id [delete: restrict, color: #2563EB]
Ref: clubs.category_id > club_categories.id [delete: restrict, color: #0F766E]
Ref: clubs.created_by > users.id [delete: restrict, color: #94A3B8]
Ref: club_tags.club_id > clubs.id [delete: cascade, color: #0F766E]
Ref: club_tags.tag_id > tags.id [delete: cascade, color: #0F766E]

// Recruitment / applications
Ref: recruitment_rounds.club_id > clubs.id [delete: restrict, color: #B45309]
Ref: recruitment_rounds.created_by > users.id [delete: restrict, color: #94A3B8]
Ref: application_questions.round_id > recruitment_rounds.id [delete: restrict, color: #B45309]
Ref: applications.(round_id, club_id) > recruitment_rounds.(id, club_id) [delete: restrict, color: #7C3AED]
Ref: applications.applicant_id > student_profiles.user_id [delete: restrict, color: #7C3AED]
Ref: applications.decided_by >? users.id [delete: restrict, color: #94A3B8]
Ref: application_answers.(application_id, round_id) > applications.(id, round_id) [delete: restrict, color: #7C3AED]
Ref: application_answers.(question_id, round_id) > application_questions.(id, round_id) [delete: restrict, color: #7C3AED]
Ref: application_links.application_id > applications.id [delete: restrict, color: #7C3AED]
Ref: application_reviews.application_id > applications.id [delete: restrict, color: #7C3AED]
Ref: application_reviews.reviewer_id > users.id [delete: restrict, color: #94A3B8]
Ref: application_status_history.application_id > applications.id [delete: restrict, color: #7C3AED]
Ref: application_status_history.actor_id >? users.id [delete: restrict, color: #94A3B8]

// Membership / notifications
Ref: club_memberships.club_id > clubs.id [delete: restrict, color: #15803D]
Ref: club_memberships.user_id > student_profiles.user_id [delete: restrict, color: #15803D]
Ref: club_memberships.(source_application_id, user_id, club_id) >? applications.(id, applicant_id, club_id) [delete: restrict, color: #15803D]
Ref: club_committee_assignments.membership_id > club_memberships.id [delete: restrict, color: #15803D]
Ref: club_committee_assignments.assigned_by > users.id [delete: restrict, color: #94A3B8]
Ref: club_committee_assignments.revoked_by >? users.id [delete: restrict, color: #94A3B8]
Ref: membership_history.membership_id > club_memberships.id [delete: restrict, color: #15803D]
Ref: membership_history.actor_id >? users.id [delete: restrict, color: #94A3B8]
Ref: notifications.recipient_id > users.id [delete: restrict, color: #BE185D]
Ref: notifications.application_id >? applications.id [delete: restrict, color: #BE185D]
Ref: notifications.membership_id >? club_memberships.id [delete: restrict, color: #BE185D]

// #region DIAGRAM GROUPS
// Header colors remain useful when table-group display is unavailable.
TableGroup "01_Identity" [color: #EFF6FF] {
  users
  student_profiles
}

TableGroup "02_Club_Discovery" [color: #F0FDFA] {
  club_categories
  clubs
  tags
  club_tags
}

TableGroup "03_Recruitment" [color: #FFFBEB] {
  recruitment_rounds
  application_questions
}

TableGroup "04_Applications" [color: #F5F3FF] {
  applications
  application_answers
  application_links
  application_reviews
  application_status_history
}

TableGroup "05_Membership" [color: #F0FDF4] {
  club_memberships
  club_committee_assignments
  membership_history
}

TableGroup "06_Notifications" [color: #FDF2F8] {
  notifications
}

// The Default view shows every table. Named views are not required.
DiagramView Default {
  Tables { * }
  TableGroups { * }
}
// #endregion

// BUSINESS RULES NOT FULLY ENFORCED BY FOREIGN KEYS / CHECKS
// 1. Club management, review and final decisions require an effective assignment:
//    assignment ACTIVE, revoked_at NULL, starts_at <= now < ends_at; account,
//    student profile, club and membership ACTIVE; membership joined_at <= now and
//    ended_at NULL; target club matches the membership. Check every request and
//    inside write transactions. ADMIN provisions initial memberships/assignments
//    under the matrix and cannot appoint itself or bypass committee requirements.
//    Do not put committee roles back into users.system_role or club_memberships.
// 2. Submit atomically: eligible student/account; active club; round PUBLISHED;
//    opens_at <= now < closes_at; closed_at IS NULL; required answers and HTTPS
//    links valid; unique student/round including a withdrawn application.
//    POLICY RECORDED 2026-10-19 (API section 11 / US-03 BR-07/08): maximum five
//    distinct effective club memberships across all club types. Count ACTIVE rows
//    with joined_at <= now and ended_at NULL; do not count pending applications or
//    ended memberships. Deny an effective membership in the target club as well.
//    Recheck this ceiling at confirmation and serialize competing confirmations
//    for the student (or equivalent); counting then writing without concurrency
//    control is insufficient. Submission itself creates no membership.
// 3. T74-D02 USER DECISION RECORDED 2026-10-27 / Pending Team Review:
//    UNDER_REVIEW is optional and requires an explicit action; reads never set it.
//    After effective recruitment closure, SUBMITTED or UNDER_REVIEW may transition
//    directly to ACCEPTED or REJECTED under the effective committee/state rules.
//    ACCEPTED -> CONFIRMED or DECLINED or EXPIRED.
//    WITHDRAWN support, resubmission and correction/reapplication policies require
//    explicit scope agreement. Existing unique student/round constraint is retained.
//    INTERVIEW is excluded from MVP; no new status is added to SQL/API/DBML here.
// 4. Review recommendations are internal opinions; applications holds the final
//    decision. Release final results, messages and history only after the parent
//    results_published_at is set. Publish in-app result notices with that change.
//    Confirmation opens at actual publication, not results_scheduled_at.
//    Recruitment PUBLISH and selection-result publication are separate actions.
//    Publication leaves application.status unchanged. SQL status history forbids
//    same-state rows; the round-publication audit representation is pending T74-D03.
// 5. Fresh confirm/decline requires ownership, ACCEPTED, published results, a
//    noncancelled round and an ACTIVE account. T74-D06 records transaction-time
//    rights/state/version recheck followed by backend time sampling after relevant
//    locks and before writing: results_published_at <= serverNow < confirmation_deadline.
//    Confirmation also requires ACTIVE student profile and club; decline does not.
//    Confirmation and membership/history must commit atomically.
//    T74-D05: after current session/ACTIVE account and ownership authorization,
//    same-final-action retry returns the stored outcome with no new decision,
//    responded_at, membership or history write; it is not a fresh deadline decision.
//    An opposite final action is rejected with 409 and no change of mind in MVP.
//    T74-D07 FINAL USER DECISION RECORDED 2026-10-27 / Pending Team Review:
//    same-application final-action retry only reads the stored outcome, without writes.
//    A fresh confirmation is rejected unchanged if ANY prior target membership row
//    exists: ACTIVE, INACTIVE, LEFT or REMOVED. MVP has no reactivation or rejoin
//    through a new confirmation. Preserve the existing row, source and history;
//    unique (club_id,user_id) remains a safeguard, not a substitute for this rule.
//    Earlier-round closed_at is not a reason to block confirmation.
// 6. At the deadline, change unanswered published ACCEPTED applications to EXPIRED
//    with actor_id NULL and history reason; responded_at remains NULL. The UI shows
//    EXPIRED as 'สละสิทธิ์ (หมดเวลาตอบรับ)', distinct from voluntary DECLINED.
//    Do not store timeout as DECLINED; the schema already has distinct EXPIRED.
//    Automatic expiry and the fresh-action time rule are recorded under T74-D06;
//    worker frequency, catch-up mechanism and acceptable lag still need team Design.
//    Fresh request APIs deny expired actions even while the worker lags; an authorized
//    same-final-action retry only reads the recorded outcome and does not reopen it.
//    Preserve each old membership period/source. Any future rejoin/reactivation
//    design is separate scope; no replacement of an existing source link in MVP.
// 7. Manual close sets closed_at to the actual server time; it does not rewrite
//    closes_at, cancel the round, delete applications or decide existing applicants.
//    Concurrency between closing and submission must be controlled transactionally.
//    A cancelled round blocks submission/review/confirmation. Cancellation requires
//    an effective PRESIDENT without an application in that round and an audited
//    reason; deny cancellation after selection results have been published.
// 8. Assignment periods/permission roles are retained per term. Revoke and create
//    a new assignment to correct them. Membership LEFT/REMOVED must revoke current
//    and future assignments transactionally so reactivation cannot revive old powers.
//    Membership INACTIVE temporarily blocks access. Check overlap and active-member
//    prerequisites in the service; a foreign key alone does not enforce these rules.
// 9. POLICY ADOPTED 2026-10-19: no committee access to a round in which the actor
//    has any application, regardless of its status. PRESIDENT publishes selection
//    results after effective closure, after deciding all applications still under
//    consideration, and before confirmation_deadline. No edits to published results
//    and no Admin override. Question edits are limited to drafts without applications.
//    Effective closure is closed_at when set, otherwise closes_at; early closure
//    therefore permits publication before the originally scheduled closes_at.
//    Still to specify separately: submitted-answer/link corrections, reapplication,
//    and any future question versioning. See ../security/permission-matrix.md.
//    External document contents can change at their origin; no automatic fetching.
// 10. Dashboard numbers are computed from clubs/rounds/applications/memberships.
//     Define unique-person versus application counts and semester membership scope
//     before acceptance; use academic_year (B.E.) + semester consistently.
// 11. updated_at is maintained by application auditing, not DEFAULT now().
//     Histories are append-only through services/permissions; Java @Version,
//     unique constraints and transactions handle concurrent updates. Use DTOs
//     appropriate to each role instead of directly serializing Java entities.
// 12. T74-D01 USER DECISION RECORDED 2026-10-27 / Pending Team Review:
//     Existing private application/resources without permission return 403 ACCESS_DENIED;
//     genuinely missing resources return 404 RESOURCE_NOT_FOUND. This supersedes the
//     old other-owner 404 hiding policy, not the separate public inactive-club rule.
//     Session/CSRF/account error codes remain unchanged. API compatibility review and
//     implementation work remain necessary; these comments add no database constraint.
// MIGRATION NOTE: this file is a revised design, not an executable migration.
// For an existing database, backfill academic_year/semester before NOT NULL checks.
// Preserve old committee roles and role-history data before removing role columns;
// create assignment rows with actual known terms, not invented historical dates.
